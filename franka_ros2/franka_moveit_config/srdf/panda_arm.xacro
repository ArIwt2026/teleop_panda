<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="panda">
  <xacro:macro name="panda_arm" params="arm_id:='panda' ">

    <xacro:include filename="$(find franka_moveit_config)/srdf/group_definition.xacro"/>
    <xacro:group_definition arm_id="${arm_id}" group_name="${arm_id}_manipulator" tip_link="${arm_id}_hand_tcp"/>
    <xacro:group_definition arm_id="${arm_id}" group_name="${arm_id}_arm" tip_link="${arm_id}_link8"/>

    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="${arm_id}_link0"/>
    <disable_collisions link1="${arm_id}_link0" link2="${arm_id}_link1" reason="Adjacent"/>
    <disable_collisions link1="${arm_id}_link0" link2="${arm_id}_link2" reason="Never"/>
    <disable_collisions link1="${arm_id}_link0" link2="${arm_id}_link3" reason="Never"/>
    <disable_collisions link1="${arm_id}_link0" link2="${arm_id}_link4" reason="Never"/>
    <disable_collisions link1="${arm_id}_link1" link2="${arm_id}_link2" reason="Adjacent"/>
    <disable_collisions link1="${arm_id}_link1" link2="${arm_id}_link3" reason="Never"/>
    <disable_collisions link1="${arm_id}_link1" link2="${arm_id}_link4" reason="Never"/>
    <disable_collisions link1="${arm_id}_link2" link2="${arm_id}_link3" reason="Adjacent"/>
    <disable_collisions link1="${arm_id}_link2" link2="${arm_id}_link4" reason="Never"/>
    <disable_collisions link1="${arm_id}_link2" link2="${arm_id}_link6" reason="Never"/>
    <disable_collisions link1="${arm_id}_link3" link2="${arm_id}_link4" reason="Adjacent"/>
    <disable_collisions link1="${arm_id}_link3" link2="${arm_id}_link5" reason="Never"/>
    <disable_collisions link1="${arm_id}_link3" link2="${arm_id}_link6" reason="Never"/>
    <disable_collisions link1="${arm_id}_link3" link2="${arm_id}_link7" reason="Never"/>
    <disable_collisions link1="${arm_id}_link4" link2="${arm_id}_link5" reason="Adjacent"/>
    <disable_collisions link1="${arm_id}_link4" link2="${arm_id}_link6" reason="Never"/>
    <disable_collisions link1="${arm_id}_link4" link2="${arm_id}_link7" reason="Never"/>
    <disable_collisions link1="${arm_id}_link4" link2="${arm_id}_link8" reason="Never"/>
    <disable_collisions link1="${arm_id}_link5" link2="${arm_id}_link6" reason="Adjacent"/>
    <disable_collisions link1="${arm_id}_link5" link2="${arm_id}_link7" reason="Never"/>
    <disable_collisions link1="${arm_id}_link6" link2="${arm_id}_link7" reason="Adjacent"/>
    <disable_collisions link1="${arm_id}_link6" link2="${arm_id}_link8" reason="Default"/>
    <disable_collisions link1="${arm_id}_link7" link2="${arm_id}_link8" reason="Adjacent"/>
    
    <disable_collisions link1="${arm_id}_link0" link2="panda_table_base" reason="Adjacent"/>
    <disable_collisions link1="${arm_id}_link1" link2="panda_table_base" reason="Never"/>
    <disable_collisions link1="${arm_id}_link2" link2="panda_table_base" reason="Never"/>
    <disable_collisions link1="${arm_id}_link3" link2="panda_table_base" reason="Never"/>
    <disable_collisions link1="${arm_id}_link4" link2="panda_table_base" reason="Never"/>

    <disable_collisions link1="${arm_id}_link0" link2="conveyor_system_link" reason="Never"/>
    <disable_collisions link1="${arm_id}_link1" link2="conveyor_system_link" reason="Never"/>
    <disable_collisions link1="${arm_id}_link0" link2="conveyor_system_link" reason="Never"/>
    <disable_collisions link1="${arm_id}_link1" link2="conveyor_system_link" reason="Never"/>
    <disable_collisions link1="${arm_id}_link2" link2="conveyor_system_link" reason="Never"/>
    <disable_collisions link1="${arm_id}_link3" link2="conveyor_system_link" reason="Never"/>
    <disable_collisions link1="${arm_id}_link4" link2="conveyor_system_link" reason="Never"/>

    <disable_collisions link1="${arm_id}_link0" link2="table_ee" reason="Never"/>
    <disable_collisions link1="${arm_id}_link1" link2="table_ee" reason="Never"/>
    <disable_collisions link1="${arm_id}_link2" link2="table_ee" reason="Never"/>
    <disable_collisions link1="${arm_id}_link3" link2="table_ee" reason="Never"/>
    <disable_collisions link1="${arm_id}_link4" link2="table_ee" reason="Never"/>


    <!-- Environment-to-Environment Collision Disables -->
    <disable_collisions link1="conveyor_system_link" link2="panda_table_base" reason="Adjacent"/>
    <disable_collisions link1="conveyor_system_link" link2="table_ee" reason="Never"/>
    <disable_collisions link1="panda_table_base" link2="table_ee" reason="Adjacent"/>
    <!-- Storage-rack collisions are checked only against Panda links. -->
    <disable_collisions link1="left_vertical_profile" link2="right_vertical_profile" reason="Adjacent"/>
    <disable_collisions link1="left_vertical_profile" link2="left_outward_profile" reason="Adjacent"/>
    <disable_collisions link1="left_vertical_profile" link2="right_outward_profile" reason="Adjacent"/>
    <disable_collisions link1="left_vertical_profile" link2="wooden_board" reason="Adjacent"/>
    <disable_collisions link1="left_vertical_profile" link2="left_outward_profile_level2" reason="Adjacent"/>
    <disable_collisions link1="left_vertical_profile" link2="right_outward_profile_level2" reason="Adjacent"/>
    <disable_collisions link1="left_vertical_profile" link2="wooden_board_level2" reason="Adjacent"/>
    <disable_collisions link1="left_vertical_profile" link2="left_outward_profile_level3" reason="Adjacent"/>
    <disable_collisions link1="left_vertical_profile" link2="right_outward_profile_level3" reason="Adjacent"/>
    <disable_collisions link1="left_vertical_profile" link2="wooden_board_level3" reason="Adjacent"/>
    <disable_collisions link1="right_vertical_profile" link2="left_outward_profile" reason="Adjacent"/>
    <disable_collisions link1="right_vertical_profile" link2="right_outward_profile" reason="Adjacent"/>
    <disable_collisions link1="right_vertical_profile" link2="wooden_board" reason="Adjacent"/>
    <disable_collisions link1="right_vertical_profile" link2="left_outward_profile_level2" reason="Adjacent"/>
    <disable_collisions link1="right_vertical_profile" link2="right_outward_profile_level2" reason="Adjacent"/>
    <disable_collisions link1="right_vertical_profile" link2="wooden_board_level2" reason="Adjacent"/>
    <disable_collisions link1="right_vertical_profile" link2="left_outward_profile_level3" reason="Adjacent"/>
    <disable_collisions link1="right_vertical_profile" link2="right_outward_profile_level3" reason="Adjacent"/>
    <disable_collisions link1="right_vertical_profile" link2="wooden_board_level3" reason="Adjacent"/>
    <disable_collisions link1="left_outward_profile" link2="right_outward_profile" reason="Adjacent"/>
    <disable_collisions link1="left_outward_profile" link2="wooden_board" reason="Adjacent"/>
    <disable_collisions link1="left_outward_profile" link2="left_outward_profile_level2" reason="Adjacent"/>
    <disable_collisions link1="left_outward_profile" link2="right_outward_profile_level2" reason="Adjacent"/>
    <disable_collisions link1="left_outward_profile" link2="wooden_board_level2" reason="Adjacent"/>
    <disable_collisions link1="left_outward_profile" link2="left_outward_profile_level3" reason="Adjacent"/>
    <disable_collisions link1="left_outward_profile" link2="right_outward_profile_level3" reason="Adjacent"/>
    <disable_collisions link1="left_outward_profile" link2="wooden_board_level3" reason="Adjacent"/>
    <disable_collisions link1="right_outward_profile" link2="wooden_board" reason="Adjacent"/>
    <disable_collisions link1="right_outward_profile" link2="left_outward_profile_level2" reason="Adjacent"/>
    <disable_collisions link1="right_outward_profile" link2="right_outward_profile_level2" reason="Adjacent"/>
    <disable_collisions link1="right_outward_profile" link2="wooden_board_level2" reason="Adjacent"/>
    <disable_collisions link1="right_outward_profile" link2="left_outward_profile_level3" reason="Adjacent"/>
    <disable_collisions link1="right_outward_profile" link2="right_outward_profile_level3" reason="Adjacent"/>
    <disable_collisions link1="right_outward_profile" link2="wooden_board_level3" reason="Adjacent"/>
    <disable_collisions link1="wooden_board" link2="left_outward_profile_level2" reason="Adjacent"/>
    <disable_collisions link1="wooden_board" link2="right_outward_profile_level2" reason="Adjacent"/>
    <disable_collisions link1="wooden_board" link2="wooden_board_level2" reason="Adjacent"/>
    <disable_collisions link1="wooden_board" link2="left_outward_profile_level3" reason="Adjacent"/>
    <disable_collisions link1="wooden_board" link2="right_outward_profile_level3" reason="Adjacent"/>
    <disable_collisions link1="wooden_board" link2="wooden_board_level3" reason="Adjacent"/>
    <disable_collisions link1="left_outward_profile_level2" link2="right_outward_profile_level2" reason="Adjacent"/>
    <disable_collisions link1="left_outward_profile_level2" link2="wooden_board_level2" reason="Adjacent"/>
    <disable_collisions link1="left_outward_profile_level2" link2="left_outward_profile_level3" reason="Adjacent"/>
    <disable_collisions link1="left_outward_profile_level2" link2="right_outward_profile_level3" reason="Adjacent"/>
    <disable_collisions link1="left_outward_profile_level2" link2="wooden_board_level3" reason="Adjacent"/>
    <disable_collisions link1="right_outward_profile_level2" link2="wooden_board_level2" reason="Adjacent"/>
    <disable_collisions link1="right_outward_profile_level2" link2="left_outward_profile_level3" reason="Adjacent"/>
    <disable_collisions link1="right_outward_profile_level2" link2="right_outward_profile_level3" reason="Adjacent"/>
    <disable_collisions link1="right_outward_profile_level2" link2="wooden_board_level3" reason="Adjacent"/>
    <disable_collisions link1="wooden_board_level2" link2="left_outward_profile_level3" reason="Adjacent"/>
    <disable_collisions link1="wooden_board_level2" link2="right_outward_profile_level3" reason="Adjacent"/>
    <disable_collisions link1="wooden_board_level2" link2="wooden_board_level3" reason="Adjacent"/>
    <disable_collisions link1="left_outward_profile_level3" link2="right_outward_profile_level3" reason="Adjacent"/>
    <disable_collisions link1="left_outward_profile_level3" link2="wooden_board_level3" reason="Adjacent"/>
    <disable_collisions link1="right_outward_profile_level3" link2="wooden_board_level3" reason="Adjacent"/>
    <disable_collisions link1="left_vertical_profile" link2="panda_table_base" reason="Never"/>
    <disable_collisions link1="left_vertical_profile" link2="conveyor_system_link" reason="Never"/>
    <disable_collisions link1="left_vertical_profile" link2="table_ee" reason="Never"/>
    <disable_collisions link1="right_vertical_profile" link2="panda_table_base" reason="Never"/>
    <disable_collisions link1="right_vertical_profile" link2="conveyor_system_link" reason="Never"/>
    <disable_collisions link1="right_vertical_profile" link2="table_ee" reason="Never"/>
    <disable_collisions link1="left_outward_profile" link2="panda_table_base" reason="Never"/>
    <disable_collisions link1="left_outward_profile" link2="conveyor_system_link" reason="Never"/>
    <disable_collisions link1="left_outward_profile" link2="table_ee" reason="Never"/>
    <disable_collisions link1="right_outward_profile" link2="panda_table_base" reason="Never"/>
    <disable_collisions link1="right_outward_profile" link2="conveyor_system_link" reason="Never"/>
    <disable_collisions link1="right_outward_profile" link2="table_ee" reason="Never"/>
    <disable_collisions link1="wooden_board" link2="panda_table_base" reason="Never"/>
    <disable_collisions link1="wooden_board" link2="conveyor_system_link" reason="Never"/>
    <disable_collisions link1="wooden_board" link2="table_ee" reason="Never"/>
    <disable_collisions link1="left_outward_profile_level2" link2="panda_table_base" reason="Never"/>
    <disable_collisions link1="left_outward_profile_level2" link2="conveyor_system_link" reason="Never"/>
    <disable_collisions link1="left_outward_profile_level2" link2="table_ee" reason="Never"/>
    <disable_collisions link1="right_outward_profile_level2" link2="panda_table_base" reason="Never"/>
    <disable_collisions link1="right_outward_profile_level2" link2="conveyor_system_link" reason="Never"/>
    <disable_collisions link1="right_outward_profile_level2" link2="table_ee" reason="Never"/>
    <disable_collisions link1="wooden_board_level2" link2="panda_table_base" reason="Never"/>
    <disable_collisions link1="wooden_board_level2" link2="conveyor_system_link" reason="Never"/>
    <disable_collisions link1="wooden_board_level2" link2="table_ee" reason="Never"/>
    <disable_collisions link1="left_outward_profile_level3" link2="panda_table_base" reason="Never"/>
    <disable_collisions link1="left_outward_profile_level3" link2="conveyor_system_link" reason="Never"/>
    <disable_collisions link1="left_outward_profile_level3" link2="table_ee" reason="Never"/>
    <disable_collisions link1="right_outward_profile_level3" link2="panda_table_base" reason="Never"/>
    <disable_collisions link1="right_outward_profile_level3" link2="conveyor_system_link" reason="Never"/>
    <disable_collisions link1="right_outward_profile_level3" link2="table_ee" reason="Never"/>
    <disable_collisions link1="wooden_board_level3" link2="panda_table_base" reason="Never"/>
    <disable_collisions link1="wooden_board_level3" link2="conveyor_system_link" reason="Never"/>
    <disable_collisions link1="wooden_board_level3" link2="table_ee" reason="Never"/>



  </xacro:macro>
</robot>
