<?xml version='1.0'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="recycle_bin">

  <xacro:macro name="recycle_bin" params="parent *origin">

    <joint name="${parent}_recycle_bin_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="recycle_bin_link"/>
    </joint>

    <link name="recycle_bin_link">
      <inertial>
        <mass value="1.0"/>
        <origin xyz="0 0 0" />
        <inertia  ixx="0.01" ixy="0.0"  ixz="0.0"  iyy="0.01"  iyz="0.0"  izz="0.01" />
      </inertial>

      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://franka_description/meshes/environment_meshes/recycle_bin/Schäferbox.dae" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="blue">
          <color rgba="0.0 0.0 0.8 1.0"/>
        </material>
      </visual>

      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://franka_description/meshes/environment_meshes/recycle_bin/Schäferbox.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

  </xacro:macro>
</robot>
